      "fields": [
        {
          "bits": "31:0",
          "name": "interrupt_level",
          "access": "R/W",
          "desc": "每 bit 选择中断触发类型：`0` = level-sensitive（default）；`1` = edge-sensitive。Reset: `32'b0`",
          "reserved": false
        }
      ]
    },
    {
      "section": 4,
      "name": "GPIOINTPOLARITY",
      "meta": {
        "offset": "0x0000003c",
        "description": "gpio_int_polarity",
        "size": "32"
      },
      "fields": [
        {
