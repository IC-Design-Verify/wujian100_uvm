        },
        {
          "bits": "4:2",
          "name": "rpl",
          "access": "R/W",
          "desc": "系统复位持续 pclk 周期数编码：<br>`000` = 2 pclk; `001` = 4; `010` = 8; `011` = 16; `100` = 32; `101` = 64; `110` = 128; `111` = 256. Reset: `3'b0`",
          "reserved": false
        },
        {
          "bits": "1",
          "name": "rmod",
          "access": "R/W",
          "desc": "`0` = Generate a system reset; `1` = First generate an interrupt, then if not cleared before second timeout generate a system reset. Reset: `1'b1`",
          "reserved": false
        },
        {
          "bits": "0",
          "name": "wdt_en",
          "access": "R/W",
          "desc": "Once enabled, only cleared by system reset. `0` = WDT disabled; `1` = WDT enabled. Reset: `1'b0`",
          "reserved": false
        }
      ]
    },
    {
      "section": 4,
      "name": "WDTTIMEOUT",
      "meta": {
        "offset": "0x00000004",
