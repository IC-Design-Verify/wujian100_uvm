          "name": "",
          "access": "—",
          "desc": "Reserved, read as 0",
          "reserved": true
        },
        {
          "bits": "0",
          "name": "rtc_stat",
          "access": "R",
          "desc": "Masked 后中断状态：`0` = inactive; `1` = active. Reset: `0x0`",
          "reserved": false
        }
      ]
    },
    {
      "section": 4,
      "name": "RTCRAWINTSTATUS",
      "meta": {
