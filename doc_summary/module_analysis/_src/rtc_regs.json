        },
        {
          "bits": "0",
          "name": "rtc_int_clr",
          "access": "R",
          "desc": "读此寄存器清除匹配中断；读完成时（end of read）清除中断。Reset: `0x0`",
          "reserved": false
        }
      ]
    },
    {
